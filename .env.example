# ============================================================================
# VibeSync — exemple de configuration d'environnement
# Copiez ce fichier en `.env` puis complétez avec vos valeurs réelles.
# ⚠️ `.env` est ignoré par git (ne jamais commiter de secrets).
# ============================================================================

# ── Base de données Neon PostgreSQL (OBLIGATOIRE pour les fonctionnalités) ──
# URL pooled (PgBouncer) pour les requêtes :
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT.neon.tech/DBNAME?sslmode=require"
# URL unpooled pour les migrations (Prisma directUrl) :
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT-unpooled.neon.tech/DBNAME?sslmode=require"

# ── Cloudinary (upload direct navigateur → CDN) ──────────────────────────────
# Cloud name public (exposé au client, avec valeur de repli embarquée) :
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="votre-cloud-name"

# Fallback serveur (upload signé) — soit l'URL complète :
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# … soit les trois variables séparées :
# CLOUDINARY_CLOUD_NAME="votre-cloud-name"
# CLOUDINARY_API_KEY="123456789"
# CLOUDINARY_API_SECRET="xxx"

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Générer : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
